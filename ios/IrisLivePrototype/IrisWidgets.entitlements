<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- LINK_API.md §14.7: the ONE genuine reason this app has an App Group.
	     The extension cannot read the app's Keychain and must not be given the
	     pairing credential, so the app writes a small non-secret snapshot here
	     and the extension only reads it. No aps-environment and no background
	     mode: the system wakes this extension to DRAW a Live Activity, it does
	     not receive the push itself. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.iris.liveprototype</string>
	</array>
</dict>
</plist>
